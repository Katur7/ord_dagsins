{
  "name": "ord_dagsins",
  "version": "1.0.0",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "start": "node src/server/server.ts",
    "dev": "node --watch src/server/server.ts",
    "preprocess": "node src/preprocess/build.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:build": "docker buildx build --platform linux/amd64 -t katur/ord_dagsins:latest --load .",
    "docker:push": "docker buildx build --platform linux/amd64 -t katur/ord_dagsins:latest --push ."
  },
  "keywords": [],
