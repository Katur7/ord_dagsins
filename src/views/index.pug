doctype html
html(lang="is")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Orð dagsins
    link(rel="stylesheet", href="/styles/index.css")

  body
    header
      p.date-header Orð dagsins #{date}

    main.hero-card
      .word-group
        span.flag 🇮🇸
        h1.main-word #{wordIs}

      hr
      
      .word-group
        span.flag 🇸🇪
        p.translations #{wordSe}

    each example in examples
      section.example-card
        span.sentence 🇮🇸 #{example.is}
        span.translation 🇸🇪 #{example.se}
